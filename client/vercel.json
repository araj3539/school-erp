{
  "buildCommand": "npm run build --workspace=@school-erp/shared && npm run build --workspace=@school-erp/client",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://school-erp-api.onrender.com/api/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
