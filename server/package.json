{
  "name": "@school-erp/server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "node fix-imports.cjs && tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "report:orphaned-documents": "tsx src/scripts/reportOrphanedStudentDocuments.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:phase1": "node scripts/phase1-gate.mjs",
    "test:e2e:phase2:documents": "node scripts/phase2-documents-gate.mjs",
    "test:e2e:phase2:payments": "node scripts/phase2-payments-gate.mjs",
    "test:e2e:phase2:audit": "node scripts/phase2-audit-gate.mjs",
    "test:e2e:phase2:roles": "node scripts/phase2-roles-gate.mjs",
    "test:e2e:phase2": "node scripts/phase2-gate.mjs",
    "test:e2e:phase3:attendance": "playwright test e2e/phase3-attendance.spec.ts",
    "test:e2e:phase3:attendance:gate": "node scripts/phase3-attendance-gate.mjs",
    "test:e2e:phase3:bulk": "playwright test e2e/phase3-attendance-bulk.spec.ts --workers=1",
    "test:e2e:phase3:students": "playwright test e2e/phase3-student-search.spec.ts --workers=1",
    "test:e2e:phase3:student-bulk": "playwright test e2e/phase3-student-bulk.spec.ts --workers=1",
    "test:e2e:phase3:teachers": "playwright test e2e/phase3-teacher-administration.spec.ts --workers=1",
    "test:e2e:phase3:attendance-report": "playwright test e2e/phase3-attendance-report.spec.ts --workers=1",
    "test:e2e:phase3:dashboard": "playwright test e2e/phase3-dashboard.spec.ts --workers=1",
    "test:e2e:phase3": "node scripts/phase3-gate.mjs",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "bcryptjs": "^2.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.5.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "read-excel-file": "^9.3.5",
    "write-excel-file": "^4.1.0",
    "zod": "^3.23.0",
    "@school-erp/shared": "0.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.5.0",
    "@types/express": "^4.17.0",
    "@types/express-rate-limit": "^5.1.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.0",
    "eslint": "^9.0.0",
    "playwright": "^1.46.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
